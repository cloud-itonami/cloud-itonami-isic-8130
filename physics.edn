;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:dev:physics` runs it.
;;
;; README "Robotics premise": robots do autonomous mowing, trimming and
;; irrigation-zone monitoring for a landscape care company (ISIC 8130). The
;; physical work declared here: an autonomous mower working up an
;; embankment (how steep a slope it may mow without tipping), and an
;; irrigation zone's PE lateral line (how much flow one zone may carry before
;; the sprinklers at the end lose their pressure).
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isic-8130"
 :cases
 [{:id :mower-up-embankment
   :kind :transport
   :procedure "autonomous mower mows a 30 m stripe straight up a grass embankment and must be able to stop hard at the top"
   :params {:mass-kg 80.0 :payload-kg 0.0 :distance-m 30.0 :v-max-mps 1.0 :a-max-mps2 0.5
            :brake-decel-mps2 1.0 :drive-force-n 400.0 :crr 0.08
            :cog-height-m 0.45 :support-half-length-m 0.30 :max-time-s 1800.0}
   :sweep {:param :slope-deg :values [0.0 5.0 10.0 15.0 20.0 25.0]}
   :quantity :min-tipover-margin
   :limit {:min 0.3 :basis "estimate: keep 30 % of the static restoring moment for turf bumps and wheel slip on wet grass; crr 0.08 for mown turf"}
   :boundary {:lo 0.0 :hi 25.0}}
  {:id :irrigation-zone-lateral
   :kind :pipe-flow
   :procedure "irrigation zone's 60 m, 25 mm PE lateral carries the zone flow from the valve box to the last sprinkler, 2 m uphill"
   :params {:diameter-m 0.025 :length-m 60.0 :roughness-m 7.0e-6 :density-kg-m3 998.0
            :viscosity-pa-s 1.0e-3 :pump-efficiency 0.60 :elevation-m 2.0}
   :sweep {:param :q-m3s :values [2.0e-4 4.0e-4 6.0e-4 8.0e-4 1.0e-3 1.3e-3]}
   :quantity :pressure-drop-pa
   :limit {:max 70000.0 :basis "estimate: lateral loss budget of about 20 % of a 3.5 bar spray-head operating pressure"}
   :boundary {:lo 1.0e-4 :hi 2.0e-3}}]}
